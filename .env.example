# ---------------------------------------------------------------------------
# Citeflow - Environment Variables (example)
# Copy this file to `.env` and fill in your own values.
# ---------------------------------------------------------------------------

# Application
APP_NAME="Citeflow"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
# Comma-separated allowed origins for CORS, or "*" to allow any origin (fine for local dev,
# tighten this to your actual frontend domain(s) in production).
CORS_ALLOWED_ORIGINS=*

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Web search
SEARCH_MAX_RESULTS=8

# Vector store
VECTOR_DB_DIR=vector_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Summarization / retrieval
SUMMARY_TOP_K=6
